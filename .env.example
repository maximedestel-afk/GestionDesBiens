# Registre des biens — configuration Supabase
# Copiez ce fichier en .env.local et renseignez les valeurs de votre projet
# Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé de service : réservée aux opérations serveur (invitation d'utilisateurs).
# Ne jamais exposer côté client ni committer sa valeur réelle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# VRPlatform (onglet Finances) : clé API "Team or partner backend"
# (x-api-key), générée depuis VRPlatform pour l'équipe Melvane Accounting.
# Réservée aux opérations serveur, jamais exposée côté client.
VRPLATFORM_API_KEY=vrp_...
VRPLATFORM_TEAM_ID=00000000-0000-0000-0000-000000000000
