# Registre des biens — configuration Supabase
# Copiez ce fichier en .env.local et renseignez les valeurs de votre projet
# Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé de service : réservée aux opérations serveur (invitation d'utilisateurs).
# Ne jamais exposer côté client ni committer sa valeur réelle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# VRPlatform (onglet Finances) : clé API "Team or partner backend"
# (x-api-key), générée depuis VRPlatform pour l'équipe Melvane Accounting.
# Réservée aux opérations serveur, jamais exposée côté client.
VRPLATFORM_API_KEY=vrp_...
VRPLATFORM_TEAM_ID=00000000-0000-0000-0000-000000000000

# Guesty (onglet DATA > Coût du ménage) : identifiants OAuth2 "Open API"
# (Guesty > Integrations > Open API). Réservés aux opérations serveur,
# jamais exposés côté client.
GUESTY_CLIENT_ID=0oa...
GUESTY_CLIENT_SECRET=...
# Secret partagé arbitraire (générez-en un vous-même) à inclure dans l'URL
# du webhook Guesty (?secret=...) pour vérifier que les notifications
# entrantes viennent bien de Guesty.
GUESTY_WEBHOOK_SECRET=...
# Vérification périodique du coût du ménage (vercel.json, toutes les 15
# minutes) en repli du webhook — Vercel ajoute automatiquement l'en-tête
# Authorization correspondant à cette valeur sur ses appels Cron ; générez-en
# une vous-même et renseignez-la aussi ici.
CRON_SECRET=...
